{
  "name": "agenttown",
  "version": "0.1.0",
  "description": "Replay your AI coding agent session (Claude Code, Codex) as a pixel-art isometric town.",
  "type": "module",
  "bin": {
    "agenttown": "cli/agenttown.mjs"
  },
  "files": [
    "cli",
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "samples": "node scripts/make-samples.mjs",
    "test": "node --test test/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agent",
    "pixel-art",
    "isometric",
    "visualization",
    "replay",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barood-labs/agenttown.git"
  },
  "homepage": "https://barood-labs.github.io/agenttown/",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
